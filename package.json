{
  "name": "publer-mcp-agent",
  "version": "0.1.0",
  "description": "MCP server that lets AI assistants manage Publer through the Publer API.",
  "type": "module",
  "main": "dist/mcpServer.js",
  "scripts": {
    "dev:stdio": "tsx src/mcpServer.ts",
    "dev:http": "tsx src/httpServer.ts",
    "build": "tsc",
    "start": "node dist/httpServer.js",
    "start:stdio": "node dist/mcpServer.js",
    "start:http": "node dist/httpServer.js",
    "inspect": "npx @modelcontextprotocol/inspector tsx src/mcpServer.ts",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "mcp",
    "publer",
    "social-media"
  ],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.13.0",
    "cors": "^2.8.6",
    "dotenv": "^16.4.7",
    "express": "^5.2.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
